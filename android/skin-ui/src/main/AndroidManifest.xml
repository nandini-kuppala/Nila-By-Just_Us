<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Only for reminders the parent asks for ("remind me in 2 hours"); silent. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only for "scan my gallery" in the eye check, and only when the parent taps it. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Only on Android 9 and older, to add the demo flash photos to the gallery when the parent taps it. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application>
        <!-- Shares a doctor report PDF the parent asked to share; nothing else is exposed. -->
        <provider
            android:name="com.nila.skin.ui.SkinFileProvider"
            android:authorities="${applicationId}.skinfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/skin_file_paths" />
        </provider>
    </application>
</manifest>
